# Maintainer: FoxStudio <contact@foxstudio.dev>
# Local build from dist-electron/linux-unpacked/
pkgname=voxelxlauncher-local
_appname="VoxelXLauncher"
_binname=voxelxlauncher
pkgver=1.5.13
pkgrel=25
pkgdesc="Martian Launcher - Minecraft Launcher by FoxStudio (local build)"
arch=('x86_64')
url="https://github.com/foxstudio-201/VoxelXClient"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libnotify')
optdepends=('libappindicator-gtk3: tray icon support')
provides=("${_binname}")
conflicts=("${_binname}")
options=('!strip' '!debug')

source=("linux-unpacked.tar.zst")
sha256sums=('2753ec6c8b7b09c9f0a4f0a6d21d53c1e2ef245ab32c9f3af89a15b9972cfaf6')

prepare() {
  cd "${srcdir}"
  bsdtar -xf linux-unpacked.tar.zst
}

package() {
  cd "${srcdir}"

  install -d "${pkgdir}/opt/${_appname}"
  cp -r linux-unpacked/* "${pkgdir}/opt/${_appname}/"
  cp -r linux-unpacked/.[!.]* "${pkgdir}/opt/${_appname}/" 2>/dev/null || true

  chmod 4755 "${pkgdir}/opt/${_appname}/chrome-sandbox"

  install -d "${pkgdir}/usr/bin"
  ln -sf "/opt/${_appname}/${_binname}" "${pkgdir}/usr/bin/${_binname}"

  install -d "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/${_binname}.desktop" << EOF
[Desktop Entry]
Name=${_appname}
Comment=${pkgdesc}
Exec="/opt/${_appname}/${_binname}" %U
Terminal=false
Type=Application
Icon=${_binname}
Categories=Game;
StartupWMClass=${_appname}
EOF

  install -d "${pkgdir}/usr/share/icons/hicolor/512x512/apps"
  install -m 644 "${srcdir}/../../public/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_binname}.png" 2>/dev/null || true
}
